RewriteEngine On
Options -MultiViews

# Direct dynamic Estimate Routes
RewriteRule ^estimate/details/?$ - [L]
RewriteRule ^estimate/[^/]+/?$ estimate/details/index.html [L]

# Direct dynamic Provider Estimates Routes
RewriteRule ^provider-estimates/details/[^/]+/?$ provider-estimates/details/details/index.html [L]
RewriteRule ^provider-estimates/[^/]+/?$ provider-estimates/view/index.html [L]

# Direct dynamic Car Hire Routes
RewriteRule ^car-hire/[^/]+/book/?$ car-hire/view/book/index.html [L]
RewriteRule ^car-hire/[^/]+/?$ car-hire/view/index.html [L]

# Direct dynamic Chauffeur Routes
RewriteRule ^services/Chauffeur/[^/]+/?$ services/Chauffeur/view/index.html [L]

# Check if .html file exists
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Existing files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Client-side routing fallback
RewriteRule ^ index.html [L]

# Custom Error Pages
ErrorDocument 404 /404.html

# Security & CORS Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>
